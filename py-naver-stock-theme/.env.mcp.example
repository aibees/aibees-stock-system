# MCP 서버 환경변수 — 실제 값으로 채운 뒤 .env.mcp 로 저장하세요.
# (이 파일은 git에 커밋해도 됩니다. .env.mcp 는 .gitignore에 추가하세요)

MCP_JWT_SECRET=여기에_openssl_rand_-hex_32_결과_입력
MCP_CLIENT_ID=jun-stock-mcp
MCP_CLIENT_SECRET=여기에_강한_랜덤_시크릿_입력

# ── 서버간 호출 인증 (maria-Authorization) ────────────────────
# 다른 프로젝트가 /api/v1/upbit/* 호출 시 maria-Authorization 헤더로 전송할 공유 시크릿.
# 호출측과 반드시 동일 값을 공유해야 함.
MARIA_AUTH_TOKEN=여기에_강한_랜덤_시크릿_입력
