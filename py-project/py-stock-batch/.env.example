# 배치 서버(py-stock-batch) 시크릿 — 이 파일을 .env 로 복사해 값을 채운다. .env 는 git·이미지에 안 들어간다.

# 비밀상회 API(py-secret-api/.env)와 같은 값. 관리자 토큰 검증용(32자 이상).
JWT_SECRET_KEY=

# (선택, 32자 이상) 서버 안에서 curl 로 배치를 돌릴 때 쓰는 키. 비워 두면 이 방식은 꺼진다.
#   curl -X POST -H "X-Batch-Key: <값>" -H "Content-Type: application/json" -d '{}' \
#        http://localhost:5557/api/v1/jobs/once/SHAPE_LABEL_JOB
BATCH_ADMIN_KEY=
