## py-stock-mcp — MCP Server (Streamable HTTP + OAuth 2.1)
##
## Flask 이미지(Dockerfile)와 동일 베이스, CMD 만 MCP 서버로 교체.
## 빌드 컨텍스트는 py-project/ 다 (shared 가 포함되어야 '../shared' 가 해석된다).
##   docker build -f py-naver-stock-theme/Dockerfile.mcp -t py-stock-mcp .   (py-project/ 에서)
## run_docker_mcp.sh 가 알아서 py-project/ 로 이동해 실행한다.

FROM python:3.12.3

ENV POETRY_VERSION=1.8.2 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN pip install -U "poetry==$POETRY_VERSION"

WORKDIR /workdir

# WORKDIR 가 /workdir 이므로 pyproject 의 '../shared' 는 /shared 로 해석된다.
COPY shared /shared

COPY py-naver-stock-theme/pyproject.toml py-naver-stock-theme/poetry.lock /workdir/

# poetry.lock 의 고정 버전 유지 + --no-root (Dockerfile 주석 참조)
RUN poetry lock --no-update \
 && poetry config virtualenvs.create false \
 && poetry install --no-interaction --no-ansi --no-root

COPY py-naver-stock-theme/ /workdir/

EXPOSE 5558

CMD ["poetry", "run", "python", "-m", "app.main", "mcp"]
