# 양봉상회 API 시크릿 — 이 파일을 .env.yangbong 으로 복사해 값을 채운다. .env.yangbong 은 git·이미지에 안 들어간다.

# yangbong 스키마 전용 계정(sql/yangbong/001_schema_account.sql 의 CREATE USER — 지금 이름은 yangbong).
DB_URL=mysql+pymysql://yangbong:<비밀번호>@<DB 호스트>:<포트>/yangbong

# 로그인 토큰 서명 키(32자 이상). 비밀상회(py-naver-stock-theme/.env)와 반드시 다른 값.
#   같으면 양봉상회 user_id=1 토큰이 비밀상회에서 관리자로 통한다.
#   만들기: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# (선택) AI 분석 하루 생성 한도 — 공통코드 stock/setting/ai 가 있으면 그쪽이 우선. 기본 5 · 100.
# AI_GEN_PER_USER_DAY=5
# AI_GEN_TOTAL_DAY=100
